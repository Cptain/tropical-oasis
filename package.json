{
  "name": "tropical-oasis",
  "version": "1.0.0",
  "scripts": {
    "sass": "sass scss/main.scss dist/main.min.css --style=compressed",
    "sass:watch": "sass --watch scss/main.scss:dist/main.min.css --style=compressed",
    "serve": "browser-sync start --server --files \"dist/main.min.css, index.html\" --no-notify",
    "dev": "npm-run-all --parallel sass:watch serve"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "npm-run-all": "^4.1.5",
    "sass": "^1.77.0",
    "sharp": "^0.34.5"
  }
}
